{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["friendCode"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)"
        }
      }
    },
    "locations": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "parties": {
      ".read": "auth != null",
      "$partyId": {
        ".write": "auth != null"
      }
    },
    "userParties": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "partyInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$partyId": {
          ".write": "auth != null"
        }
      }
    }
  }
}
