{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["friendCode"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)"
        }
      }
    },
    "locations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "locationShares": {
      "$viewerUid": {
        ".read": "auth != null && auth.uid === $viewerUid",
        "$ownerUid": {
          ".write": "auth != null && auth.uid === $ownerUid && (!newData.exists() || (root.child('friends').child($ownerUid).child($viewerUid).exists() && root.child('friends').child($viewerUid).child($ownerUid).exists()))"
        }
      }
    },
    "locationShareTargets": {
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        "$viewerUid": {
          ".write": "auth != null && auth.uid === $ownerUid && (!newData.exists() || (root.child('friends').child($ownerUid).child($viewerUid).exists() && root.child('friends').child($viewerUid).child($ownerUid).exists()))"
        }
      }
    },
    "stepLogs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "userStats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "visits": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "routeLogs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "parties": {
      ".read": "auth != null",
      "$partyId": {
        ".write": "auth != null"
      }
    },
    "userParties": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && data.exists() && root.child('parties').child(data.child('partyId').val()).child('hostUid').val() === auth.uid))"
      }
    },
    "partyInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$partyId": {
          ".write": "auth != null"
        }
      }
    },
    "pushTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$tokenKey": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.child('token').isString() && newData.child('uid').val() === auth.uid)"
        }
      }
    }
  }
}
